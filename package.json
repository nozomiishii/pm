{
  "name": "@nozomiishii/pm",
  "version": "0.2.7",
  "description": "Project manager CLI — jump to projects via fzf",
  "homepage": "https://github.com/nozomiishii/pm#readme",
  "bugs": {
    "url": "https://github.com/nozomiishii/pm/issues"
  },
  "license": "MIT",
  "author": "Nozomi Ishii",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nozomiishii/pm.git"
  },
  "bin": {
    "pm": "./dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs",
    "src/pm.zsh"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown -F lib",
    "build:exe": "tsdown -F exe",
    "demo": "docker run --rm -v \"$(pwd)\":/vhs pm-vhs",
    "demo:all": "bash demo/create.sh",
    "demo:logo": "docker run --rm -v \"$(pwd)\":/vhs pm-vhs demo/logo.tape",
    "dev": "tsx src/cli.ts",
    "eslint": "eslint --max-warnings=0 --cache",
    "format": "pnpm oxfmt . --check",
    "format:fix": "pnpm oxfmt .",
    "install:local": "bash install.sh",
    "lint": "pnpm eslint",
    "lint:fix": "pnpm eslint --fix",
    "logo:colorize": "tsx src/logo/create-logo-color.ts",
    "oxfmt": "oxfmt",
    "prepare": "lefthook install --force",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "uninstall:local": "bash uninstall.sh"
  },
  "devDependencies": {
    "@nozomiishii/commitlint-config": "2.8.1",
    "@nozomiishii/eslint-config": "2.8.1",
    "@nozomiishii/lefthook-config": "2.8.1",
    "@nozomiishii/oxfmt-config": "2.8.1",
    "@nozomiishii/tsconfig": "2.8.1",
    "@tsdown/exe": "0.23.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "25.9.0",
      "onFail": "download"
    }
  }
}
